# Alfred runtime — local dev uses ./.alfred in the repo (see scripts/env.sh)
ALFRED_DATA_DIR=./.alfred

# Server (optional overrides)
ALFRED_HOST=0.0.0.0
ALFRED_PORT=8080

# Optional: pre-seed admin token (otherwise generated on init)
# ALFRED_ADMIN_TOKEN=

# AI keys (prefer admin UI / secrets.enc; env vars useful in Docker)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MOONSHOT_API_KEY=   # Kimi — also set in Admin → Secrets → AI keys

# Slack (prefer admin UI)
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# Git
# GIT_TOKEN=

# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
